{
  "manifest_version": 3,
  "name": "Later — Save from Gmail",
  "version": "0.1.0",
  "description": "Save the currently-open Gmail email to Later with Cmd+Shift+L.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Save the currently-open Gmail email to Later"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
